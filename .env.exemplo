# Copie este arquivo com o nome .env (sem o ".exemplo") e preencha.
# O .env NÃO vai para o GitHub: cada pessoa usa as próprias chaves.

# 1) https://my.telegram.org -> entre com o seu número -> "API development tools"
#    -> crie um app (nome e descrição quaisquer) e copie o api_id e o api_hash
TG_API_ID=12345678
TG_API_HASH=cole_o_api_hash

# 2) No Telegram, fale com o @BotFather -> /newbot -> copie o token do seu bot.
#    Depois abra o seu bot e mande /start para ele (senão ele não consegue te avisar).
TG_BOT_TOKEN=cole_o_token_do_bot

# Opcional
# Senha do painel (obrigatória se abrir na rede com HOST_PAINEL=0.0.0.0). Vazio = sem senha.
SENHA_PAINEL=
# PORTA_PAINEL=8787
# HOST_PAINEL=127.0.0.1
